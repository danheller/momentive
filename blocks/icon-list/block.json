{
	"name": "momentive/icon-list",
	"apiVersion": 3,
	"title": "Icon List",
	"category": "momentive",
	"icon": "list-view",
	"description": "A list of items, each with an icon and a short description. Replaces the hand-built features section.",
	"supports": {
		"html": false,
		"anchor": true,
		"dimensions": {
			"minHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": false,
			"__experimentalDefaultControls": {
				"margin": false,
				"padding": false
			}
		}
	},
	"attributes": {
		"heading":     { "type": "string",  "default": "Key Features" },
		"showHeading": { "type": "boolean", "default": true },
		"items":       { "type": "array",   "default": [] }
	}
}
